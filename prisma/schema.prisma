// ARTLY — database schema
// Default provider is SQLite (zero-config, file based). To use PostgreSQL,
// change `provider` to "postgresql", set DATABASE_URL, delete the
// `prisma/migrations` folder and run `npx prisma migrate dev --name init`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tagline     String    @default("")
  description String    @default("")
  image       String    @default("")
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  shortDescription String         @default("")
  description      String         @default("")
  /// JSON array of { label: string, value: string }
  specs            String         @default("[]")
  /// JSON array of strings
  features         String         @default("[]")
  /// JSON array of strings
  variations       String         @default("[]")
  featured         Boolean        @default(false)
  published        Boolean        @default(true)
  sortOrder        Int            @default(0)
  seoTitle         String         @default("")
  seoDescription   String         @default("")
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  enquiries        Enquiry[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([published, featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Enquiry {
  id          String   @id @default(cuid())
  fullName    String
  companyName String   @default("")
  phone       String
  email       String
  interestedIn String
  message     String
  /// NEW | IN_PROGRESS | RESOLVED | ARCHIVED
  status      String   @default("NEW")
  adminNotes  String   @default("")
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourcePage  String   @default("")
  ipHash      String   @default("")
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Administrator")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
