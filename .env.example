# ─────────────────────────────────────────────────────────────
# ARTLY website — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ─────────────────────────────────────────────────────────────

# Public URL of the website (no trailing slash). Used for SEO,
# sitemap, canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database (SQLite file by default — see README for PostgreSQL).
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Initial admin account — created by `npm run db:seed` if it does not exist.
# Change the password after first login (Admin → Settings → Change password).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Folder where product images uploaded in the admin panel are stored.
# Must be persistent storage in production (e.g. a Docker volume).
UPLOAD_DIR="./storage/uploads"

# ── Email notifications for new enquiries (optional) ─────────
# Leave SMTP_HOST empty to disable email; enquiries are still saved
# to the database and visible in the admin panel.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# "From" address for notification emails, e.g. "ARTLY Website <no-reply@yourdomain.com>"
MAIL_FROM=""
# Where enquiry notifications are sent (comma-separated for several).
ENQUIRY_NOTIFY_TO=""
